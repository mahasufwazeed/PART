{
  "name": "part-hyperlocal-marketplace",
  "version": "1.0.0",
  "private": true,
  "description": "PART – People At Right Time: Hyperlocal Task Marketplace for Chennai & Beyond",
  "workspaces": [
    "shared",
    "mobile",
    "admin"
  ],
  "scripts": {
    "preinstall": "node render-start.js",
    "build": "npm --workspace=mobile run build",
    "start": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:mobile": "npm --workspace=mobile run start",
    "dev:admin": "npm --workspace=admin run dev",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "typescript": "^5.4.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react-leaflet": "^4.2.1",
    "vite": "8.3.5"
  }
}
